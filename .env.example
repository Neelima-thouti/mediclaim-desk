# This file only lists the settings. The app reads real environment variables,
# so set them in your terminal (see README) or in your hosting service.

# --- Model ---
LLM_PROVIDER=mock                        # mock (offline demo) | azure | openai
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_DEPLOYMENT=<your deployment name, e.g. the GPT-5.1 deployment>
# AZURE_OPENAI_API_KEY=<key>             # leave unset to use Entra ID / Managed Identity
# LLM_REASONING_EFFORT=low               # optional: none | low | medium | high

# --- Workflow engine ---
# ENGINE=graph                           # graph (LangGraph, default) | plain

# --- Azure SQL (default is local SQLite) ---
# AZURE_SQL_CONN_STR=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<db>;Uid=<user>;Pwd=<password>;Encrypt=yes;Connection Timeout=60;

# --- Cosmos DB audit store (default is local JSON files) ---
# COSMOS_ENDPOINT=https://<account>.documents.azure.com:443/
# COSMOS_KEY=<key>
# COSMOS_DB=claims
# COSMOS_CONTAINER=audit

# --- Blob Storage for uploaded documents (default is ./local_blobs) ---
# AZURE_STORAGE_CONN_STR=<connection string>
# BLOB_CONTAINER=claim-documents

# --- API ---
# API_KEY=<optional shared key; the UI sends it if VITE_API_KEY is set>
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SEED_DEMO_DATA=true                      # loads the sample policy and past bills; set false for anything real
